# Better-Auth Configuration
# Database connection (PostgreSQL)
# This should be the direct PostgreSQL connection string, not the Hasura GraphQL endpoint
DATABASE_URL=postgresql://user:password@host:5432/database

# Hasura Configuration (for existing GraphQL operations)
HASURA_PROJECT_ENDPOINT=https://your-project.hasura.app/v1/graphql
HASURA_ADMIN_SECRET=your-hasura-admin-secret

# JWT Secret (for Hasura JWT claims)
JWT_SECRET=your-jwt-secret-key-min-32-characters

# Better-Auth & Next.js
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
NEXT_PUBLIC_AUTH_GOOGLE_ID=your-google-client-id

# Strava OAuth (if used)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
NEXT_PUBLIC_STRAVA_CLIENT_ID=your-strava-client-id

# BCrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Node Environment
NODE_ENV=development
